# Leave the Supabase values empty (or set NEXT_PUBLIC_DEMO_MODE=1) to run in demo mode:
# no login, data saved in this browser only.
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Spotify app (developer.spotify.com/dashboard). Optional: without it, song details
# fall back to oEmbed/manual entry and moments open in Spotify instead of playing here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify requires https or a loopback IP (not "localhost") for redirect URIs.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# 32 random bytes, base64: openssl rand -base64 32
SPOTIFY_TOKEN_KEY=
SPOTIFY_MARKET=IN
# SPOTIFY_SCOPES="streaming user-read-private user-modify-playback-state user-read-playback-state"

# Optional: YouTube Data API key, used only for video length (videos.list, 1 quota unit).
# Without it, the length is read from the player on first preview.
YOUTUBE_API_KEY=
